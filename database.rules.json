{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && ($uid === auth.uid || root.child('users').child(auth.uid).child('profile').child('role').val() === 'owner' || root.child('users').child(auth.uid).child('profile').child('phone').val() === '9510006797')"
      }
    },
    "recharge_requests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$requestId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "withdrawal_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "gift_codes": {
      ".read": true,
      ".write": "auth != null"
    },
    "plans": {
      ".read": true,
      ".write": "auth != null"
    },
    "config": {
      ".read": true,
      ".write": "auth != null"
    },
    "announcements": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
